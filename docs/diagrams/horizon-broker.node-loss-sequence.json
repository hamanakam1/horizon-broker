  "cards": [
    {
      "dot": "emerald",
      "title": "Accepted before it runs",
      "items": [
        "The caller receives a durable job id before any engine work starts",
        "Both ingresses produce the same InferenceJob, so the path after this point is identical",
        "The interactive lane dispatches at once and the flex lane waits for a batch"
      ]
    },
    {
      "dot": "amber",
      "title": "Durable by default",
      "items": [
        "Every checkpoint is written to the journal first and the ledger second",
        "The snapshot carries the prompt hash, so a mismatch is rejected rather than replayed",
        "The failed node is excluded from the next attempt"
      ]
    },
    {
      "dot": "rose",
      "title": "Bounded by the budget",
      "items": [
        "Silence past the heartbeat timeout declares the node LOST",
        "Recovery is direct, never re-queued through the shared lane",
        "The retry budget is finite and ends the job loudly"
      ]
    }
  ]
