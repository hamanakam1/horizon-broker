  "cards": [
    {
      "dot": "emerald",
      "title": "One rail, five states",
      "items": [
        "The happy path is the rail the reader follows: queued, windowing, dispatched, running, completed",
        "Only Flex work waits in a window; interactive work is dispatched at once",
        "The window closes on batch size, dwell, expiry, or an idle fleet"
      ]
    },
    {
      "dot": "amber",
      "title": "The fault loop is real topology",
      "items": [
        "Recovering returns the job to Running with a resume point, not a card saying retry",
        "The job is re-dispatched directly, never through the shared queue",
        "The failed node is excluded from the next attempt"
      ]
    },
    {
      "dot": "rose",
      "title": "Two exits end the story",
      "items": [
        "Failed is the retry budget running out; an expiry fails the job too",
        "Cancelled is the operator stopping the work with DELETE /v1/jobs/{job_id}",
        "Neither points back into active execution"
      ]
    }
  ]
