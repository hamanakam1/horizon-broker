  "cards": [
    {
      "dot": "emerald",
      "title": "One base model, one rule",
      "items": [
        "Every wire type inherits BrokerModel, which forbids unknown fields",
        "Adding a field is a contract change, not a convenience",
        "The base is abstract on purpose: nothing constructs it directly"
      ]
    },
    {
      "dot": "cyan",
      "title": "Enums carry the state machine",
      "items": [
        "JobState and NodeHealth are the vocabulary of the broker",
        "A new state is a contract change that every consumer sees",
        "The lifecycle diagram reads these enums as its states"
      ]
    },
    {
      "dot": "amber",
      "title": "One type is a proposal",
      "items": [
        "FleetControl does not exist yet; the roadmap proposes it for v1.0",
        "It is the only interface in the plan, and the engine would realize it",
        "Everything else on this diagram is in the code today"
      ]
    }
  ]
