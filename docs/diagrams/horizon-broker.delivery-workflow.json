  "cards": [
    {
      "dot": "emerald",
      "title": "Order of work",
      "items": [
        "Correctness first: the fleet cannot be trusted until the fault paths are honest",
        "Throughput next: batching and streaming are what the product promise needs",
        "Scale last: one broker owns one fleet until the control plane exists"
      ]
    },
    {
      "dot": "amber",
      "title": "Gates are blocking",
      "items": [
        "Gate A demands a green fault-path suite, not a green unit suite",
        "Gate B demands measured evidence from a soak on real hardware",
        "A failed gate stops the phase instead of shipping a regression"
      ]
    },
    {
      "dot": "cyan",
      "title": "Proof before support",
      "items": [
        "The edge trial runs on the real fleet for seven days",
        "Support starts only after the SLOs hold under real faults",
        "Every phase ships with a runbook and a rollback"
      ]
    }
  ]
