  "cards": [
    {
      "dot": "cyan",
      "title": "This is a document model, not a schema",
      "items": [
        "The broker persists JSON documents, so the types here are the contract field types",
        "There is no SQL in the broker; the column names are the contract field names",
        "The one-to-many ends are the attempts and the replayed tokens"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two layers, one key",
      "items": [
        "Every snapshot is committed as a ledger document with a content hash",
        "The resume point and the partial tokens hang off the snapshot, not off the document",
        "The prompt hash inside the resume point is what makes a mismatch rejectable"
      ]
    },
    {
      "dot": "amber",
      "title": "What is not durable yet",
      "items": [
        "The job envelope is journalled but the rebuild path is never called",
        "The fleet snapshot lives in memory only",
        "Phase 1 of the roadmap makes the replay real"
      ]
    }
  ]
