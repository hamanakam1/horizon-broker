  "cards": [
    {
      "dot": "emerald",
      "title": "Three seams",
      "items": [
        "contracts/ is the wire format every other package imports",
        "ingress/ validates and hands over, and never touches the queue",
        "scheduler/ produces dispatch batches and never talks to a node"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two durability layers",
      "items": [
        "recovery/ writes the journal first and the ledger second",
        "A ledger outage degrades durability to machine-local, never to lost",
        "The snapshot carries the prompt hash, so a mismatch is rejected"
      ]
    },
    {
      "dot": "amber",
      "title": "One broker, one fleet",
      "items": [
        "nodes/ owns the whole fleet view and every failure verdict",
        "routing/ decides where the work runs, never whether it runs",
        "There is no broker-to-broker coordination in this tree yet"
      ]
    }
  ]
}
